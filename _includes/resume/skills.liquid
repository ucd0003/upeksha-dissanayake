<ul class="card-text font-weight-light list-group list-group-flush">
  {% for content in data[1] %}
    <li class="list-group-item">
      <div class="row">
        <div class="col-md-12">
          <span class="font-weight-bold">{{ content.name }}:</span>
          {{ content.keywords | join: ', ' }}
        </div>
      </div>
    </li>
  {% endfor %}
</ul>
